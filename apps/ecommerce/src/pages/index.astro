---
// apps/ecommerce/src/pages/index.astro - YouTubeVolt Portal de Videos
const title = "YouTubeVolt - Portal de Videos & Bóveda Personal";

const INITIAL_VIDEOS = [
  {
    id: 1,
    youtubeVideoId: "5sLYA38pX4s",
    title: "¿Qué son los Agentes de IA y cómo transformarán el software?",
    channelName: "DotCSV",
    thumbnailUrl: "https://img.youtube.com/vi/5sLYA38pX4s/hqdefault.jpg",
    duration: "22:15",
    collectionId: "ia-agentes",
    collectionName: "Inteligencia Artificial & Agentes",
    tags: ["AI", "Agentes", "LLMs", "Autonomía"],
    description: "Introducción conceptual profunda a los agentes autónomos de IA, bucles de razonamiento (ReAct) y herramientas conectadas a APIs reales.",
    notes: "Los agentes autónomos no solo responden texto, toman decisiones y coordinan herramientas para resolver problemas complejos."
  },
  {
    id: 2,
    youtubeVideoId: "31ieHmcTUOk",
    title: "Curso de Docker desde cero para principiantes",
    channelName: "Midudev",
    thumbnailUrl: "https://img.youtube.com/vi/31ieHmcTUOk/hqdefault.jpg",
    duration: "45:30",
    collectionId: "cloud-devops",
    collectionName: "Cloud, Docker & Dokploy",
    tags: ["Docker", "Containers", "DevOps", "Dokploy"],
    description: "Aprende contenedores, imágenes multi-stage y cómo empaquetar aplicaciones para producción y despliegue en Dokploy.",
    notes: "Utilizar el multi-stage build para reducir el tamaño final de la imagen en Dokploy."
  },
  {
    id: 3,
    youtubeVideoId: "d3k5fH4u_0Y",
    title: "Arquitectura Limpia (Clean Architecture) explicada con ejemplos",
    channelName: "MoureDev by Brais Moure",
    thumbnailUrl: "https://img.youtube.com/vi/d3k5fH4u_0Y/hqdefault.jpg",
    duration: "38:40",
    collectionId: "arquitectura-clean",
    collectionName: "Arquitectura Limpia & Clean Code",
    tags: ["Clean Architecture", "Software Design", "SOLID"],
    description: "Separación clara entre capas de Dominio, Casos de Uso, Datos y Presentación para crear software mantenible.",
    notes: "Regla de dependencia: Las capas externas conocen a las internas, pero el Dominio es totalmente independiente."
  },
  {
    id: 4,
    youtubeVideoId: "T_wKhn5xNfA",
    title: "PWA (Progressive Web Apps) Tutorial Práctico con React y Vite",
    channelName: "Fazt Code",
    thumbnailUrl: "https://img.youtube.com/vi/T_wKhn5xNfA/hqdefault.jpg",
    duration: "28:10",
    collectionId: "desarrollo-web-mobile",
    collectionName: "Desarrollo Web & Mobile (PWA/Kotlin)",
    tags: ["PWA", "React", "ServiceWorker", "Offline"],
    description: "Aprende a convertir cualquier aplicación React en una PWA instalable con Service Workers y caché offline.",
    notes: "Configurar manifest.json con 'display: standalone' y caché de assets estáticos en el Service Worker."
  },
  {
    id: 5,
    youtubeVideoId: "NWONeJKn6kc",
    title: "Machine Learning & Big Data Analytics - Curso Completo",
    channelName: "NextCollege Tech",
    thumbnailUrl: "https://img.youtube.com/vi/NWONeJKn6kc/hqdefault.jpg",
    duration: "1:15:00",
    collectionId: "data-bi",
    collectionName: "Data Engineering & Big Data",
    tags: ["Machine Learning", "Big Data", "Python"],
    description: "Fundamentos de analítica avanzada, procesamiento de datos masivos y modelos predictivos para toma de decisiones.",
    notes: "Material de soporte para el módulo de ingeniería de datos y analítica en la nube."
  },
  {
    id: 6,
    youtubeVideoId: "t2Pz0Wz7Z2Y",
    title: "Kotlin Multiplatform: Comparte lógica de negocio entre iOS y Android",
    channelName: "AristiDevs",
    thumbnailUrl: "https://img.youtube.com/vi/t2Pz0Wz7Z2Y/hqdefault.jpg",
    duration: "32:45",
    collectionId: "desarrollo-web-mobile",
    collectionName: "Desarrollo Web & Mobile (PWA/Kotlin)",
    tags: ["Kotlin", "KMP", "Compose", "Mobile"],
    description: "Estructura de proyectos KMP, Koin para inyección de dependencias y persistencia de datos local compartida.",
    notes: "Comparativa entre desarrollo móvil nativo KMP y arquitecturas PWA web multiplataforma."
  }
];

const COLLECTIONS = [
  { id: "all", name: "Todos los Videos" },
  { id: "ia-agentes", name: "🤖 IA & Agentes" },
  { id: "cloud-devops", name: "☁️ Cloud & Dokploy" },
  { id: "desarrollo-web-mobile", name: "📱 Web & Mobile" },
  { id: "arquitectura-clean", name: "🏗️ Arquitectura Limpia" },
  { id: "data-bi", name: "📊 Data & BI" }
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #090d16;
      --surface: #111827;
      --card: #151d2f;
      --border: #1e293b;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #ff0033;
      --primary-hover: #e11d48;
      --accent-coral: #f43f5e;
      --glow: rgba(255, 0, 51, 0.35);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Top Navbar */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(11, 15, 23, 0.9);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.85rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
      color: white;
    }
    .brand-logo {
      width: 36px;
      height: 36px;
      border-radius: 9px;
      background: linear-gradient(135deg, #ff0033 0%, #b91c1c 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px var(--glow);
    }
    .brand-name {
      font-size: 1.3rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .brand-name span { color: var(--accent-coral); }

    .search-box {
      flex: 1;
      max-width: 500px;
      position: relative;
    }
    .search-input {
      width: 100%;
      background: #151d2f;
      border: 1px solid #243048;
      border-radius: 9999px;
      padding: 0.65rem 1.25rem;
      color: white;
      font-size: 0.88rem;
      outline: none;
      transition: all 0.2s;
    }
    .search-input:focus {
      border-color: var(--accent-coral);
      box-shadow: 0 0 15px rgba(244, 63, 94, 0.25);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .btn-nav {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.55rem 1rem;
      border-radius: 0.5rem;
      font-size: 0.84rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-pwa {
      background: linear-gradient(135deg, #ff0033 0%, #be123c 100%);
      color: white;
      box-shadow: 0 4px 14px rgba(255, 0, 51, 0.35);
    }
    .btn-pwa:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 0, 51, 0.5);
    }
    .btn-admin {
      background: #1e293b;
      color: #38bdf8;
      border: 1px solid #334155;
    }
    .btn-admin:hover {
      background: #25334d;
      color: white;
    }

    /* Container */
    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
      width: 100%;
    }

    /* Hero Featured Spotlight */
    .hero-spotlight {
      position: relative;
      background: linear-gradient(135deg, #151d2f 0%, #0d131f 100%);
      border: 1px solid #243048;
      border-radius: 1.5rem;
      overflow: hidden;
      margin-bottom: 2.5rem;
      box-shadow: 0 20px 50px rgba(0,0,0,0.5);
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }
    @media (max-width: 860px) {
      .hero-spotlight { grid-template-columns: 1fr; }
    }
    .hero-video-wrapper {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: #000;
      cursor: pointer;
    }
    .hero-thumb {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s;
    }
    .hero-video-wrapper:hover .hero-thumb {
      transform: scale(1.02);
    }
    .hero-play-btn {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.4);
    }
    .play-circle {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: #ff0033;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 30px rgba(255, 0, 51, 0.7);
      transition: all 0.2s;
    }
    .play-circle:hover {
      transform: scale(1.1);
      box-shadow: 0 0 45px rgba(255, 0, 51, 0.9);
    }
    .hero-info {
      padding: 2.5rem;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(244, 63, 94, 0.15);
      border: 1px solid rgba(244, 63, 94, 0.3);
      color: #f43f5e;
      padding: 0.35rem 0.8rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }
    .hero-title {
      font-size: 1.8rem;
      font-weight: 800;
      line-height: 1.25;
      margin-bottom: 0.75rem;
      color: white;
    }
    .hero-desc {
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    .hero-notes {
      background: rgba(56, 189, 248, 0.08);
      border-left: 3px solid #38bdf8;
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      font-size: 0.82rem;
      color: #93c5fd;
      margin-bottom: 1.5rem;
    }

    /* Filter Pills */
    .filter-bar {
      display: flex;
      gap: 0.65rem;
      overflow-x: auto;
      padding-bottom: 1rem;
      margin-bottom: 1.75rem;
      scrollbar-width: none;
    }
    .filter-bar::-webkit-scrollbar { display: none; }
    .filter-chip {
      background: #151d2f;
      color: var(--text-muted);
      border: 1px solid #243048;
      padding: 0.5rem 1.15rem;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s;
    }
    .filter-chip.active, .filter-chip:hover {
      background: #ff0033;
      color: white;
      border-color: #ff0033;
      box-shadow: 0 4px 14px rgba(255, 0, 51, 0.35);
    }

    /* Video Grid */
    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.75rem;
      margin-bottom: 4rem;
    }
    .video-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 1rem;
      overflow: hidden;
      cursor: pointer;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
    }
    .video-card:hover {
      transform: translateY(-4px);
      border-color: rgba(244, 63, 94, 0.5);
      box-shadow: 0 16px 36px rgba(0,0,0,0.5);
    }
    .card-thumb-wrap {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: #000;
    }
    .card-thumb {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s;
    }
    .video-card:hover .card-thumb {
      transform: scale(1.03);
    }
    .card-duration {
      position: absolute;
      bottom: 8px;
      right: 8px;
      background: rgba(0,0,0,0.85);
      color: white;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
    }
    .card-content {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .card-title {
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.35;
      color: white;
      margin-bottom: 0.6rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
      font-size: 0.8rem;
    }
    .card-channel {
      color: #cbd5e1;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .channel-avatar {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--accent-coral);
      color: white;
      font-size: 0.65rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .card-col {
      color: var(--accent-coral);
      font-size: 0.74rem;
    }
    .card-tags {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin-top: auto;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .tag-chip {
      background: #1e293b;
      color: #94a3b8;
      font-size: 0.68rem;
      padding: 2px 8px;
      border-radius: 4px;
    }

    /* Modal Player */
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.92);
      backdrop-filter: blur(10px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .modal-backdrop.open {
      display: flex;
    }
    .modal-content {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 1.25rem;
      max-width: 900px;
      width: 100%;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0,0,0,0.8);
      position: relative;
    }
    .modal-header {
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #1f2937;
    }
    .modal-close {
      background: transparent;
      border: none;
      color: #94a3b8;
      font-size: 1.5rem;
      cursor: pointer;
    }
    .modal-video-frame {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: #000;
    }
    .modal-video-frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
    .modal-body {
      padding: 1.5rem;
    }

    /* Footer */
    footer {
      background: #070a12;
      border-top: 1px solid #151d2f;
      padding: 3rem 1.5rem;
      margin-top: auto;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.88rem;
    }
    .footer-links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }
    .footer-link {
      color: #cbd5e1;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s;
    }
    .footer-link:hover { color: var(--accent-coral); }
  </style>
</head>
<body>
  <!-- Top Navbar -->
  <header class="navbar">
    <a href="/" class="brand">
      <div class="brand-logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
        </svg>
      </div>
      <div class="brand-name">
        YouTube<span>Volt</span>
      </div>
    </a>

    <div class="search-box">
      <input
        type="text"
        id="liveSearchInput"
        class="search-input"
        placeholder="Buscar videos por título, creador o palabras clave..."
      />
    </div>

    <div class="nav-actions">
      <a href="/app" class="btn-nav btn-pwa">
        📱 Bóveda Mobile PWA
      </a>
      <a href="/admin" class="btn-nav btn-admin">
        ⚙️ Studio Admin
      </a>
    </div>
  </header>

  <main class="container">
    <!-- Hero Spotlight Video -->
    <section class="hero-spotlight">
      <div class="hero-video-wrapper" onclick="openPlayerModal('5sLYA38pX4s', '¿Qué son los Agentes de IA y cómo transformarán el software?', 'DotCSV', 'Los agentes autónomos no solo responden texto, toman decisiones y coordinan herramientas para resolver problemas complejos.')">
        <img
          src="https://img.youtube.com/vi/5sLYA38pX4s/hqdefault.jpg"
          alt="Video Destacado"
          class="hero-thumb"
        />
        <div class="hero-play-btn">
          <div class="play-circle">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
          </div>
        </div>
      </div>
      <div class="hero-info">
        <div class="hero-badge">⚡ Video Destacado de la Bóveda</div>
        <h1 class="hero-title">¿Qué son los Agentes de IA y cómo transformarán el software?</h1>
        <p class="hero-desc">
          Introducción conceptual profunda a los agentes autónomos de IA, bucles de razonamiento (ReAct) y herramientas conectadas a APIs reales por DotCSV.
        </p>
        <div class="hero-notes">
          💡 <strong>Nota de la Bóveda:</strong> "Los agentes no solo predicen texto, ejecutan código y acciones en el mundo real."
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <button
            onclick="openPlayerModal('5sLYA38pX4s', '¿Qué son los Agentes de IA y cómo transformarán el software?', 'DotCSV', 'Los agentes autónomos no solo responden texto, toman decisiones y coordinan herramientas para resolver problemas complejos.')"
            class="btn-nav btn-pwa"
            style="border: none; cursor: pointer; padding: 0.75rem 1.5rem;"
          >
            ▶️ Reproducir Video
          </button>
          <a href="/app" class="btn-nav btn-admin" style="padding: 0.75rem 1.25rem;">
            📱 Ver en App Mobile
          </a>
        </div>
      </div>
    </section>

    <!-- Filter Chips -->
    <div class="filter-bar">
      {COLLECTIONS.map(c => (
        <button class={`filter-chip ${c.id === 'all' ? 'active' : ''}`} data-col={c.id}>
          {c.name}
        </button>
      ))}
    </div>

    <!-- Video Grid -->
    <section class="video-grid" id="videosGrid">
      {INITIAL_VIDEOS.map(video => (
        <div
          class="video-card"
          data-collection={video.collectionId}
          data-title={video.title.toLowerCase()}
          data-channel={video.channelName.toLowerCase()}
          data-tags={video.tags.join(' ').toLowerCase()}
          onclick={`openPlayerModal('${video.youtubeVideoId}', '${video.title.replace(/'/g, "\\'")}', '${video.channelName}', '${video.notes.replace(/'/g, "\\'")}')`}
        >
          <div class="card-thumb-wrap">
            <img src={video.thumbnailUrl} alt={video.title} class="card-thumb" loading="lazy" />
            <div class="card-duration">{video.duration}</div>
          </div>
          <div class="card-content">
            <h3 class="card-title">{video.title}</h3>
            <div class="card-meta">
              <div class="card-channel">
                <span class="channel-avatar">{video.channelName[0]}</span>
                {video.channelName}
              </div>
              <span class="card-col">{video.collectionName}</span>
            </div>
            <div class="card-tags">
              {video.tags.map(t => (
                <span class="tag-chip">#{t}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </section>
  </main>

  <!-- Modal Player -->
  <div class="modal-backdrop" id="playerModal" onclick="closeModalOnBackdrop(event)">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modalVideoTitle" style="color: white; font-size: 1.1rem; font-weight: 700;">Título del Video</h3>
        <button class="modal-close" onclick="closePlayerModal()">&times;</button>
      </div>
      <div class="modal-video-frame">
        <iframe id="modalIframe" src="" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
      </div>
      <div class="modal-body">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <div style="color: var(--accent-coral); font-weight: 700;" id="modalChannel">Canal</div>
          <a id="modalExternalLink" href="#" target="_blank" style="color: #38bdf8; text-decoration: none; font-size: 0.85rem; font-weight: 600;">
            ↗️ Abrir en YouTube Oficial
          </a>
        </div>
        <div id="modalNotesBox" style="background: rgba(56, 189, 248, 0.08); border-left: 3px solid #38bdf8; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.84rem; color: #93c5fd;">
          💡 <strong>Anotación en la Bóveda:</strong> <span id="modalNotesText">Notas</span>
        </div>
      </div>
    </div>
  </div>

  <footer>
    <div class="footer-links">
      <a href="/" class="footer-link">🌐 Portal de Videos</a>
      <a href="/app" class="footer-link">📱 Bóveda PWA Mobile</a>
      <a href="/admin" class="footer-link">⚙️ Panel Studio</a>
      <a href="/api/health" class="footer-link">🩺 Health Check</a>
      <a href="/api/videos" class="footer-link">🎬 API REST</a>
    </div>
    <p>
      YouTubeVolt &bull; Arquitectura 3 Capas: Astro (Portal) + React (PWA) + React (Admin) + Node.js API + MySQL &bull; Dokploy CI/CD
    </p>
  </footer>

  <script is:inline>
    // Live Client Side Sync with API
    async function syncVideosFromApi() {
      try {
        const res = await fetch('/api/videos');
        if (!res.ok) return;
        const json = await res.json();
        if (!json.data || json.data.length === 0) return;

        const grid = document.getElementById('videosGrid');
        if (!grid) return;

        grid.innerHTML = json.data.map(video => `
          <div
            class="video-card"
            data-collection="${video.collectionId}"
            data-title="${(video.title || '').toLowerCase()}"
            data-channel="${(video.channelName || '').toLowerCase()}"
            data-tags="${(video.tags || []).join(' ').toLowerCase()}"
            onclick="openPlayerModal('${video.youtubeVideoId}', '${(video.title || '').replace(/'/g, "\\'")}', '${video.channelName}', '${(video.personalNotes || '').replace(/'/g, "\\'")}')"
          >
            <div class="card-thumb-wrap">
              <img src="${video.thumbnailUrl || 'https://img.youtube.com/vi/' + video.youtubeVideoId + '/hqdefault.jpg'}" alt="${video.title}" class="card-thumb" loading="lazy" />
              <div class="card-duration">${video.duration || '15:00'}</div>
            </div>
            <div class="card-content">
              <h3 class="card-title">${video.title}</h3>
              <div class="card-meta">
                <div class="card-channel">
                  <span class="channel-avatar">${(video.channelName || 'Y')[0]}</span>
                  ${video.channelName}
                </div>
                <span class="card-col">${video.collectionName || 'General'}</span>
              </div>
              <div class="card-tags">
                ${(video.tags || []).map(t => `<span class="tag-chip">#${t}</span>`).join('')}
              </div>
            </div>
          </div>
        `).join('');
      } catch (err) {
        console.warn('API local sync fallback:', err);
      }
    }

    // Modal logic
    function openPlayerModal(videoId, title, channel, notes) {
      const modal = document.getElementById('playerModal');
      const iframe = document.getElementById('modalIframe');
      const titleElem = document.getElementById('modalVideoTitle');
      const channelElem = document.getElementById('modalChannel');
      const linkElem = document.getElementById('modalExternalLink');
      const notesElem = document.getElementById('modalNotesText');

      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      titleElem.textContent = title;
      channelElem.textContent = `Canal: ${channel}`;
      linkElem.href = `https://www.youtube.com/watch?v=${videoId}`;
      notesElem.textContent = notes || 'Sin notas adicionales en la bóveda.';

      modal.classList.add('open');
    }

    function closePlayerModal() {
      const modal = document.getElementById('playerModal');
      const iframe = document.getElementById('modalIframe');
      iframe.src = '';
      modal.classList.remove('open');
    }

    function closeModalOnBackdrop(e) {
      if (e.target.id === 'playerModal') {
        closePlayerModal();
      }
    }

    // Filter Chips
    document.querySelectorAll('.filter-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        const col = chip.getAttribute('data-col');
        applyFilters(col, document.getElementById('liveSearchInput').value);
      });
    });

    // Search Input
    const searchInput = document.getElementById('liveSearchInput');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const activeChip = document.querySelector('.filter-chip.active');
        const col = activeChip ? activeChip.getAttribute('data-col') : 'all';
        applyFilters(col, e.target.value);
      });
    }

    function applyFilters(collection, query) {
      const q = (query || '').toLowerCase().trim();
      const cards = document.querySelectorAll('.video-card');

      cards.forEach(card => {
        const cardCol = card.getAttribute('data-collection');
        const title = card.getAttribute('data-title') || '';
        const channel = card.getAttribute('data-channel') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchCol = (collection === 'all' || cardCol === collection);
        const matchQuery = !q || title.includes(q) || channel.includes(q) || tags.includes(q);

        if (matchCol && matchQuery) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      syncVideosFromApi();
    });
  </script>
</body>
</html>
