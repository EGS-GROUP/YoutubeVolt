---
// apps/ecommerce/src/pages/index.astro - YouTubeVolt Portal de Videos Musicales
const title = "YouTubeVolt - Bóveda Musical: Salsa, Rock en Español & Charlie Zaa";

const INITIAL_VIDEOS = [
  {
    id: 1,
    youtubeVideoId: "HbGIN3GwD8s",
