---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="NextCollege Burger Rapid: La primera cadena de hamburguesas gourmet de cocción rápida a fuego vivo. Pide en vivo con entrega en 25 minutos." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #090d16;
      --card: #131b2e;
      --card-hover: #18233c;
      --border: #1e293b;
      --border-accent: rgba(37, 99, 235, 0.4);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --accent: #38bdf8;
      --amber: #f59e0b;
      --flame: #ea580c;
      --success: #10b981;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.5;
    }

    /* Ambient Glow background */
    .ambient-glow {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100vw;
      height: 600px;
      background: radial-gradient(circle at 50% 15%, rgba(37, 99, 235, 0.15) 0%, rgba(234, 88, 12, 0.08) 40%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* Container */
    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1.5rem;
      position: relative;
      z-index: 1;
    }

    /* Navbar */
    nav {
      border-bottom: 1px solid var(--border);
      background: rgba(9, 13, 22, 0.85);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 72px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text);
    }

    .brand-icon {
      font-size: 1.75rem;
      background: linear-gradient(135deg, rgba(234, 88, 12, 0.2), rgba(37, 99, 235, 0.2));
      border: 1px solid rgba(234, 88, 12, 0.3);
      padding: 0.35rem 0.5rem;
      border-radius: 12px;
      display: inline-flex;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    .brand-title {
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: -0.02em;
    }

    .brand-subtitle {
      font-size: 0.7rem;
      color: var(--accent);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.15rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
      border: 1px solid transparent;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary) 0%, #1e40af 100%);
      color: white;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #3b82f6 0%, var(--primary) 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
    }

    .btn-outline {
      background: rgba(255, 255, 255, 0.04);
      border-color: var(--border);
      color: var(--text);
    }

    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }

    /* Hero */
    .hero {
      padding: 4.5rem 0 3.5rem;
      text-align: center;
    }

    .pill-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(234, 88, 12, 0.12);
      border: 1px solid rgba(234, 88, 12, 0.3);
      color: #fb923c;
      padding: 0.4rem 1.1rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 5vw, 4.2rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.03em;
      margin-bottom: 1.25rem;
      background: linear-gradient(135deg, #ffffff 30%, #cbd5e1 70%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-lead {
      color: var(--text-muted);
      font-size: 1.2rem;
      max-width: 720px;
      margin: 0 auto 2.25rem;
      line-height: 1.6;
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 1.75rem;
      flex-wrap: wrap;
      margin-bottom: 2.75rem;
    }

    .stat-chip {
      background: var(--card);
      border: 1px solid var(--border);
      padding: 0.65rem 1.25rem;
      border-radius: 12px;
      font-size: 0.875rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text);
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    /* Filter & Search Bar */
    .catalog-header {
      margin: 3.5rem 0 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .catalog-top-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .section-title {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .section-subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .search-wrapper {
      position: relative;
      width: 100%;
      max-width: 380px;
    }

    .search-input {
      width: 100%;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 9999px;
      padding: 0.75rem 1.25rem 0.75rem 2.75rem;
      color: var(--text);
      font-size: 0.9rem;
      font-family: inherit;
      outline: none;
      transition: all 0.2s;
    }

    .search-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
    }

    .category-pills {
      display: flex;
      gap: 0.6rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      scrollbar-width: none;
    }
    .category-pills::-webkit-scrollbar { display: none; }

    .cat-btn {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.2s;
    }

    .cat-btn.active, .cat-btn:hover {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
    }

    /* Burger Grid */
    .burger-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.75rem;
      margin-bottom: 4rem;
    }

    @media (min-width: 1024px) {
      .burger-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (min-width: 1280px) {
      .burger-grid {
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      }
    }

    /* Burger Card */
    .burger-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.25s ease;
      position: relative;
    }

    .burger-card:hover {
      transform: translateY(-6px);
      border-color: var(--border-accent);
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 25px rgba(37, 99, 235, 0.15);
    }

    .card-media {
      position: relative;
      width: 100%;
      height: 220px;
      overflow: hidden;
      background: #0f172a;
    }

    .card-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .burger-card:hover .card-image {
      transform: scale(1.06);
    }

    .badge-category {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(9, 13, 22, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      color: #38bdf8;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.3rem 0.75rem;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .card-rating {
      position: absolute;
      top: 14px;
      right: 14px;
      background: rgba(9, 13, 22, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      color: #f59e0b;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.3rem 0.65rem;
      border-radius: 9999px;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    /* Specialty Level Badge (Crucial requirement) */
    .specialty-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(234, 88, 12, 0.2) 100%);
      border: 1px solid rgba(245, 158, 11, 0.4);
      color: #fbbf24;
      font-size: 0.8rem;
      font-weight: 800;
      padding: 0.35rem 0.85rem;
      border-radius: 8px;
      letter-spacing: 0.02em;
      margin-bottom: 0.75rem;
      align-self: flex-start;
    }

    .card-body {
      padding: 1.4rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .card-title {
      font-size: 1.25rem;
      font-weight: 800;
      line-height: 1.25;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .card-desc {
      color: var(--text-muted);
      font-size: 0.875rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .card-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 0.75rem;
      color: #64748b;
      margin-bottom: 1.25rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      gap: 0.75rem;
    }

    .card-price {
      display: flex;
      flex-direction: column;
    }

    .price-label {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 700;
    }

    .price-value {
      font-size: 1.4rem;
      font-weight: 900;
      color: #38bdf8;
      line-height: 1;
    }

    .card-buttons {
      display: flex;
      gap: 0.5rem;
    }

    /* "Ver" Button (Crucial requirement) */
    .btn-view {
      background: rgba(37, 99, 235, 0.12);
      border: 1px solid rgba(37, 99, 235, 0.4);
      color: #60a5fa;
      padding: 0.55rem 1rem;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.2s;
    }

    .btn-view:hover {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
      transform: translateY(-1px);
    }

    .btn-order-quick {
      background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
      color: white;
      border: none;
      padding: 0.55rem 0.95rem;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      transition: all 0.2s;
    }

    .btn-order-quick:hover {
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(234, 88, 12, 0.4);
    }

    /* Interactive Details Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(3, 7, 18, 0.85);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 1.5rem;
      opacity: 0;
      visibility: hidden;
      transition: all 0.25s ease;
    }

    .modal-backdrop.open {
      opacity: 1;
      visibility: visible;
    }

    .modal-content {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 24px;
      max-width: 680px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8);
      position: relative;
      transform: scale(0.95) translateY(10px);
      transition: transform 0.25s ease;
    }

    .modal-backdrop.open .modal-content {
      transform: scale(1) translateY(0);
    }

    .modal-close-btn {
      position: absolute;
      top: 18px;
      right: 18px;
      background: rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: white;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1.25rem;
      z-index: 10;
      transition: background 0.2s;
    }

    .modal-close-btn:hover {
      background: #ef4444;
      border-color: #ef4444;
    }

    .modal-image-wrapper {
      position: relative;
      height: 280px;
      width: 100%;
      overflow: hidden;
      border-top-left-radius: 24px;
      border-top-right-radius: 24px;
    }

    .modal-image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .modal-body {
      padding: 2rem;
    }

    .modal-tags {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
    }

    .modal-title {
      font-size: 1.85rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }

    .modal-desc {
      color: var(--text-muted);
      line-height: 1.6;
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .ingredients-box {
      background: #172033;
      border: 1px solid #1f2937;
      border-radius: 16px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .ingredients-title {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 800;
      color: #38bdf8;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .ingredients-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .ing-chip {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.35rem 0.75rem;
      border-radius: 8px;
      font-size: 0.8rem;
      color: #e2e8f0;
    }

    .nutrition-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 1.75rem;
      text-align: center;
    }

    .nutrition-card {
      background: #172033;
      border: 1px solid #1f2937;
      border-radius: 12px;
      padding: 0.85rem;
    }

    .nutrition-val {
      font-size: 1.2rem;
      font-weight: 800;
      color: #f8fafc;
    }

    .nutrition-label {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .modal-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #1f2937;
      padding-top: 1.25rem;
    }

    /* Highlights Section */
    .features-section {
      padding: 4rem 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: rgba(19, 27, 46, 0.5);
      margin-bottom: 4rem;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
    }

    .feature-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.75rem;
      text-align: left;
    }

    .feature-icon {
      font-size: 2rem;
      margin-bottom: 1rem;
      display: inline-block;
    }

    .feature-title {
      font-size: 1.15rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
    }

    .feature-text {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* Footer */
    footer {
      padding: 3rem 0;
      text-align: center;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: #38bdf8;
      text-decoration: none;
      font-weight: 600;
    }

    .footer-links a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="ambient-glow"></div>

  <!-- Navbar -->
  <nav>
    <div class="container nav-inner">
      <a href="/" class="brand">
        <span class="brand-icon">🍔</span>
        <div class="brand-text">
          <span class="brand-title">NextCollege Burger Rapid</span>
          <span class="brand-subtitle">Brasas Vivas &bull; Gourmet Express</span>
        </div>
      </a>

      <div class="nav-links">
        <a href="#catalogo" class="btn btn-outline" style="display: none; @media(min-width: 640px) { display: inline-flex; }">
          🔥 Catálogo 10 Variantes
        </a>
        <a href="/app" class="btn btn-primary">
          📱 Pedir en PWA Mobile
        </a>
        <a href="/admin" class="btn btn-outline">
          ⚙️ Panel Admin
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="pill-badge">
        🔥 10 Variantes Artesanales &bull; Fuego Vivo &bull; Despacho en 25 Min
      </div>
      <h1>El Templo de las Hamburguesas de Autor</h1>
      <p class="hero-lead">
        Medallones 100% Angus madurados a la brasa, queso cheddar inglés derretido al soplete y pan brioche horneado al amanecer. Prueba las especialidades del Rey.
      </p>

      <div class="hero-stats">
        <div class="stat-chip">
          <span>👑</span> 4 Variantes Maestras Insignia
        </div>
        <div class="stat-chip">
          <span>⚡</span> Entrega Rapid en 25 min
        </div>
        <div class="stat-chip">
          <span>⭐</span> 4.95 / 5.0 (+34,000 Reseñas)
        </div>
        <div class="stat-chip">
          <span>🥖</span> Pan Brioche de Masa Madre
        </div>
      </div>

      <div class="hero-actions">
        <a href="#catalogo" class="btn btn-primary" style="padding: 0.85rem 2rem; font-size: 1rem;">
          🍔 Ver las 10 Hamburguesas
        </a>
        <a href="/app" class="btn btn-outline" style="padding: 0.85rem 1.75rem; font-size: 1rem; border-color: rgba(234, 88, 12, 0.4); color: #fb923c;">
          🛵 Simular Compra en App PWA
        </a>
      </div>
    </div>
  </section>

  <!-- Features Strip -->
  <section class="features-section">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon">🥩</span>
          <h3 class="feature-title">Cortes Angus Seleccionados</h3>
          <p class="feature-text">Blend único de picaña, costilla y entraña molido a diario sin conservantes ni aditivos.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🔥</span>
          <h3 class="feature-title">Parrilla a Quebracho Blanco</h3>
          <p class="feature-text">Cocción a 320°C que sella los jugos interiores y deja esa inconfundible costra caramelizada.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📱</span>
          <h3 class="feature-title">App PWA con Seguimiento</h3>
          <p class="feature-text">Ordena con 3 toques desde tu móvil sin instalar nada de las tiendas. Funciona offline.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🏆</span>
          <h3 class="feature-title">Especialidades con Gramaje Real</h3>
          <p class="feature-text">Medallones XXL de hasta 420g pesados en crudo. Calidad y generosidad garantizada.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Catalog Section -->
  <section class="container" id="catalogo">
    <div class="catalog-header">
      <div class="catalog-top-row">
        <div>
          <h2 class="section-title">Catálogo de 10 Variantes Destacadas</h2>
          <p class="section-subtitle">Explora nuestras 10 recetas maestras con nivel de especialidad y gramaje certificado</p>
        </div>

        <!-- Live Search -->
        <div class="search-wrapper">
          <span class="search-icon">🔍</span>
          <input 
            type="text" 
            id="searchInput" 
            class="search-input" 
            placeholder="Buscar por nombre, carne o ingrediente..." 
          />
        </div>
      </div>

      <!-- Categories Filter Tabs -->
      <div class="category-pills" id="categoryTabs">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            class={`cat-btn ${idx === 0 ? 'active' : ''}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Burger Cards Grid -->
    <div class="burger-grid" id="burgerGrid">
      {burgers.map((burger) => (
        <article 
          class="burger-card" 
          data-category={burger.category}
          data-name={burger.name.toLowerCase()}
          data-specialty={burger.specialty.toLowerCase()}
          data-description={burger.description.toLowerCase()}
        >
          <div class="card-media">
            <img src={burger.image} alt={burger.name} class="card-image" loading="lazy" />
            <span class="badge-category">{burger.category}</span>
            <div class="card-rating">
              <span>★</span> {burger.rating}
            </div>
          </div>

          <div class="card-body">
            <!-- Specialty Level Badge (Requirement 1) -->
            <div class="specialty-badge">
              <span>⚖️</span> {burger.specialty}
            </div>

            <h3 class="card-title">{burger.name}</h3>
            <p class="card-desc">{burger.description}</p>

            <div class="card-meta">
              <span>⏱️ {burger.cookTime}</span>
              <span>&bull;</span>
              <span>🔥 {burger.calories}</span>
              <span>&bull;</span>
              <span>🍔 Pan Brioche</span>
            </div>

            <div class="card-footer">
              <div class="card-price">
                <span class="price-label">Precio</span>
                <span class="price-value">${burger.price.toFixed(2)}</span>
              </div>

              <div class="card-buttons">
                <!-- "Ver" Button (Requirement 1) -->
                <button 
                  type="button" 
                  class="btn-view" 
                  data-burger={JSON.stringify(burger)}
                  aria-label={`Ver detalles de ${burger.name}`}
                >
                  <span>👁️</span> Ver
                </button>
                <a href="/app" class="btn-order-quick" title="Pedir en App PWA">
                  <span>🛒</span> Pedir
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Interactive Details Modal (Rendered on Demand via Vanilla JS) -->
  <div class="modal-backdrop" id="detailModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-content">
      <button class="modal-close-btn" id="modalCloseBtn" aria-label="Cerrar modal">&times;</button>
      <div class="modal-image-wrapper">
        <img id="modalImg" src="" alt="Detalle de Hamburguesa" />
      </div>
      <div class="modal-body">
        <div class="modal-tags">
          <span class="badge-category" id="modalCategory" style="position:static;">Categoría</span>
          <div class="specialty-badge" id="modalSpecialty" style="margin-bottom:0;">Especialidad</div>
        </div>

        <h2 class="modal-title" id="modalTitle">Título Hamburguesa</h2>
        <p class="modal-desc" id="modalDescription">Descripción gastronómica detallada de la hamburguesa seleccionada.</p>

        <!-- Ingredients Section -->
        <div class="ingredients-box">
          <div class="ingredients-title">
            <span>🌿</span> Ingredientes Seleccionados &bull; Preparación en Vivo
          </div>
          <div class="ingredients-chips" id="modalIngredients">
            <!-- Chips inserted dynamically -->
          </div>
        </div>

        <!-- Nutritional / Cook Specs -->
        <div class="nutrition-row">
          <div class="nutrition-card">
            <div class="nutrition-val" id="modalCookTime">12 min</div>
            <div class="nutrition-label">Parrilla a Fuego Vivo</div>
          </div>
          <div class="nutrition-card">
            <div class="nutrition-val" id="modalCalories">920 kcal</div>
            <div class="nutrition-label">Valor Energético</div>
          </div>
          <div class="nutrition-card">
            <div class="nutrition-val" id="modalRating">★ 4.98</div>
            <div class="nutrition-label">Satisfacción Gourmet</div>
          </div>
        </div>

        <!-- Modal Footer Actions -->
        <div class="modal-actions">
          <div>
            <span class="price-label">Precio Final</span>
            <div class="price-value" id="modalPrice" style="font-size: 2rem;">$0.00</div>
          </div>

          <div style="display: flex; gap: 0.75rem;">
            <button class="btn btn-outline" id="modalDismissBtn" style="padding: 0.75rem 1.25rem;">
              Cerrar
            </button>
            <a href="/app" class="btn btn-primary" style="padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%); border: none;">
              📱 Pedir en PWA Mobile
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-links">
        <a href="/">🌐 E-commerce Portal</a>
        <span>&bull;</span>
        <a href="/app">📱 PWA Mobile (Simulador)</a>
        <span>&bull;</span>
        <a href="/admin">⚙️ Panel Administrativo</a>
        <span>&bull;</span>
        <a href="/api/health">🩺 Health Check API</a>
        <span>&bull;</span>
        <a href="/api/products">📦 API Productos JSON</a>
      </div>
      <p style="margin-bottom: 0.5rem;">
        &copy; 2026 <strong>NextCollege Burger Rapid</strong> &bull; Primera Versión Comercial
      </p>
      <p style="font-size: 0.75rem; color: #475569;">
        Tecnología: Astro + React + Node.js Express + MySQL &bull; Despliegue Continuo con Dokploy
      </p>
    </div>
  </footer>

  <!-- Client-side Interactive Logic -->
  <script is:inline>
    // 1. Modal Logic
    const modal = document.getElementById('detailModal');
    const modalCloseBtn = document.getElementById('modalCloseBtn');
    const modalDismissBtn = document.getElementById('modalDismissBtn');
    const modalImg = document.getElementById('modalImg');
    const modalTitle = document.getElementById('modalTitle');
    const modalCategory = document.getElementById('modalCategory');
    const modalSpecialty = document.getElementById('modalSpecialty');
    const modalDescription = document.getElementById('modalDescription');
    const modalIngredients = document.getElementById('modalIngredients');
    const modalCookTime = document.getElementById('modalCookTime');
    const modalCalories = document.getElementById('modalCalories');
    const modalRating = document.getElementById('modalRating');
    const modalPrice = document.getElementById('modalPrice');

    function openModal(burger) {
      modalImg.src = burger.image;
      modalTitle.textContent = burger.name;
      modalCategory.textContent = burger.category;
      modalSpecialty.textContent = '⚖️ ' + burger.specialty;
      modalDescription.textContent = burger.description;
      modalCookTime.textContent = burger.cookTime;
      modalCalories.textContent = burger.calories;
      modalRating.textContent = '★ ' + burger.rating;
      modalPrice.textContent = '$' + burger.price.toFixed(2);

      // Ingredients chips
      modalIngredients.innerHTML = '';
      if (burger.ingredients && burger.ingredients.length > 0) {
        burger.ingredients.forEach(function(ing) {
          const chip = document.createElement('span');
          chip.className = 'ing-chip';
          chip.textContent = ing;
          modalIngredients.appendChild(chip);
        });
      }

      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Attach click to all "Ver" buttons
    document.querySelectorAll('.btn-view').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const data = JSON.parse(btn.getAttribute('data-burger'));
        openModal(data);
      });
    });

    modalCloseBtn.addEventListener('click', closeModal);
    modalDismissBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        closeModal();
      }
    });

    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
    });

    // 2. Search & Category Filters
    const searchInput = document.getElementById('searchInput');
    const catButtons = document.querySelectorAll('.cat-btn');
    const cards = document.querySelectorAll('.burger-card');

    let currentCategory = 'Todas';
    let searchQuery = '';

    function filterCards() {
      cards.forEach(function(card) {
        const cat = card.getAttribute('data-category');
        const name = card.getAttribute('data-name');
        const specialty = card.getAttribute('data-specialty');
        const desc = card.getAttribute('data-description');

        const matchesCat = (currentCategory === 'Todas' || cat === currentCategory);
        const textToSearch = name + ' ' + specialty + ' ' + desc;
        const matchesSearch = searchQuery === '' || textToSearch.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    catButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        catButtons.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentCategory = btn.getAttribute('data-category');
        filterCards();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        searchQuery = e.target.value.toLowerCase().trim();
        filterCards();
      });
    }
  </script>
</body>
</html>
