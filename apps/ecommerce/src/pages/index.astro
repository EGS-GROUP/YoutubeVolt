    channelName: "Charlie Zaa",
    thumbnailUrl: "https://img.youtube.com/vi/HbGIN3GwD8s/hqdefault.jpg",
    duration: "4:15",
    collectionId: "baladas-charlie-zaa",
    collectionName: "Baladas & Boleros de Charlie Zaa",
